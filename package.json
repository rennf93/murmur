{
  "name": "murmur-it",
  "version": "0.2.8",
  "description": "Local, client-agnostic message bus for AI CLI sessions with group threads",
  "license": "MIT",
  "author": "Renn F",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rennf93/murmur.git"
  },
